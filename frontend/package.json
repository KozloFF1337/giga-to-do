{
  "name": "giga-todo-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "tsx scripts/build-pixel-assets.ts && vite --host 127.0.0.1",
    "build": "node scripts/check-vendor.mjs && tsx scripts/build-pixel-assets.ts && tsc --noEmit && vite build",
    "test": "node --test tests/*.test.mjs",
    "check:vendor": "node scripts/check-vendor.mjs"
  },
  "dependencies": {
    "react": "19.2.5",
    "react-dom": "19.2.5"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "pngjs": "7.0.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "8.0.8"
  }
}
